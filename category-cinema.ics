SUMMARY:El estudiante novato (Cine con piano en directo)
DTSTART;TZID=Europe/Madrid:20260417T200000
DTEND;TZID=Europe/Madrid:20260417T211600
UID:cb2ea19b2a842cd156c5bd9bfae97fbc7accd918d634dd52f9d2ed772be8019c
