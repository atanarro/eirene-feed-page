BEGIN:VEVENT
SUMMARY:Jajás en el Barrio
DTSTART;TZID=Europe/Madrid:20261126T213000
UID:e7bd438dd4ef0ebb73ada1a7c1c30974eaf7febcbff369f387737fa8a4a38ab5
CATEGORIES:theater
