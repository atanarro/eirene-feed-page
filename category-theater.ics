BEGIN:VEVENT
SUMMARY:Golpe a golpe\, verso a verso
DTSTART;TZID=Europe/Madrid:20261106T000000
DTEND;TZID=Europe/Madrid:20261129T000000
UID:152b6e19a9bb2baa18659cb58bb4fbe5e2cd48b7396ad3e0a126ab31ac2ef7f9
