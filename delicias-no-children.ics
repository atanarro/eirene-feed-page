BEGIN:VEVENT
SUMMARY:Sentido y sensibilidad
DTSTART;TZID=Europe/Madrid:20261116T155000
DTEND;TZID=Europe/Madrid:20261116T180100
UID:1dec6b2cf8fc1c4bbedefa0f568c2452f74caca5b359cf2e1d0f15fdd160e3cc
CATEGORIES:cinema
