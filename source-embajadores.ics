BEGIN:VEVENT
SUMMARY:La odisea
DTSTART;TZID=Europe/Madrid:20260916T214500
DTEND;TZID=Europe/Madrid:20260917T003700
UID:f05116757fe26cfe1719ccd0679a8a23b3d4928a1c088a5bdc201857b63096e2
CATEGORIES:cinema
