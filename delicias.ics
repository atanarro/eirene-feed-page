DTSTART;TZID=Europe/Madrid:20261128T140000
DTEND;TZID=Europe/Madrid:20261128T163800
UID:cdbfc138593f2e36bbf5e56d85f5ead1dec204e7e3adbf54e57e36d5a7adea52
CATEGORIES:cinema
