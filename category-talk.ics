BEGIN:VEVENT
SUMMARY:"La Pajarería"
DTSTART;TZID=Europe/Madrid:20261115T130000
DTEND;TZID=Europe/Madrid:20261115T130000
UID:7c92050f20f39348ce11f1ce19780032b8990446447cd4e3f7d205a7351569ac
CATEGORIES:talk
