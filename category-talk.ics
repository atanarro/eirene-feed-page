BEGIN:VEVENT
SUMMARY:Presentación: «África madre. La manada»\, de Laura Lazzarino
DTSTART;TZID=Europe/Madrid:20261120T190000
UID:c98f548936e396d843ff7e0a6477ba63e39c9ecd40a2a8385a03e6b2b21254eb
CATEGORIES:talk
DESCRIPTION:Laura Lazzarino visita la librería Desnivel para presentarnos
