BEGIN:VEVENT
SUMMARY:IVÁN “MELÓN” LEWIS QUARTET
DTSTART;TZID=Europe/Madrid:20261009T220000
DTEND;TZID=Europe/Madrid:20261009T220000
UID:4113cc434fab28f222582a4d6dc9622db27459e43e8c6e88a8b9f4a018ab6ac7
