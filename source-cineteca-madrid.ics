  de Maya Deren e Yvonne Rainer
DTSTART;TZID=Europe/Madrid:20260305T190000
UID:5d291a232b30890ef78492bf4746b0045fcdc92b3a6bfc494e20d927a99996a9
CATEGORIES:cinema
