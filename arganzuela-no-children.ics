DTSTART;TZID=Europe/Madrid:20260228T183000
DTEND;TZID=Europe/Madrid:20260228T235900
UID:ddce7203c1e0bc86e4c9865a57ff03f897d0dcc6987c035253d775714d79a4a7
CATEGORIES:theater
DESCRIPTION:Compañía: Asociación Cultural Somnis.  Categoría: Teatro. 
  Edad recomendada: mayores de 10 años.  Duración: 120 minutos.  Sinopsis
