BEGIN:VEVENT
SUMMARY:Sentido y sensibilidad
DTSTART;TZID=Europe/Madrid:20261114T153000
DTEND;TZID=Europe/Madrid:20261114T174100
UID:5a1877c69ad8d3a4a08aa6a870e2825771c1696abd913bfa2ccd7bfa777bb09c
CATEGORIES:cinema
DESCRIPTION:EE.UU. · Drama · 131 min. Dirección: Georgia Oakley. Repart
